{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ESNext", "DOM"],
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@opr/definitions": ["definitions/src"],
      "@opr/shared": ["packages/shared/src"],
      "@opr/xlsx": ["packages/xlsx/src"],
      "@opr/docx": ["packages/docx/src"],
      "@opr/pptx": ["packages/pptx/src"]
    }
  }
}
